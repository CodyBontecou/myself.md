# Generated automatically by npm run auth:setup. Do not put real credentials in this example.
PUBLIC_URL=http://192.168.1.100:3000
OAUTH_ISSUER=http://192.168.1.100:8080/realms/qr-connect
KEYCLOAK_URL=http://192.168.1.100:8080
DEV_HOST=192.168.1.100
ALLOW_HTTP_DEV=1
EXPO_PUBLIC_ALLOW_HTTP=1
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=replace-with-generated-password

# Social login credentials: keep actual values only in ignored .env.
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# APPLE_SERVICE_ID=com.myself.md.login
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY_PATH=.local/apple/AuthKey_KEYID.p8

# Native lifetime purchase (US $19.99); store products must be created separately.
EXPO_PUBLIC_LIFETIME_PRODUCT_ID=myself_md_lifetime
LIFETIME_PRODUCT_ID=myself_md_lifetime
# APPLE_IAP_APP_ID=
# APPLE_IAP_ROOT_CERTIFICATES=/path/to/AppleRootCA-G3.cer
# APPLE_IAP_KEY_PATH=/path/to/AuthKey.p8
# APPLE_IAP_KEY_ID=
# APPLE_IAP_ISSUER_ID=
# IAP_SANDBOX=1
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/play-service-account.json

# Existing-app migration. Apple signing key must have access to these apps too.
HEALTH_MD_APPLE_APP_ID=
ISO_ME_APPLE_APP_ID=6761960794
EXPO_PUBLIC_ACCOUNT_SERVER=https://myself.md

# iOS Debug-only screenshot feedback (native rebuild required)
GRIPE_API_KEY=
GRIPE_REPOSITORY=CodyBontecou/agent-bridge
GRIPE_DRY_RUN=0
