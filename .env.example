OAUTH_ISSUER=http://192.168.1.100:8080/realms/qr-connect
KEYCLOAK_URL=http://192.168.1.100:8080
DEV_HOST=192.168.1.100
ALLOW_HTTP_DEV=1
EXPO_PUBLIC_ALLOW_HTTP=1
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=replace-with-generated-password

