{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "project": [
    "*.js",
    "*.cjs",
    "core/**/*.js",
    "server/**/*.js",
    "scripts/**/*.js",
    "client/**/*.js",
    "plugins/**/*.cjs",
    "src/**/*.js",
    "dashboard/**/*.js",
    "!dashboard/dist/**",
    "dashboard/**/*.css",
    "worker/**/*.js"
  ],
  "ignoreDependencies": ["@types/punycode", "cloudflare"],
  "ignoreBinaries": ["fly"],
  "entry": [
    "scripts/*.js",
    "plugins/*.cjs",
    "index.js",
    "src/app/**/*.js",
    "dashboard/app.js",
    "dashboard/style.css",
    "worker/index.js"
  ]
}
