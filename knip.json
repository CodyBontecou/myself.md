{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "project": [
    "*.js",
    "*.cjs",
    "core/**/*.js",
    "server/**/*.js",
    "scripts/**/*.js",
    "client/**/*.js",
    "plugins/**/*.cjs",
    "src/**/*.js",
    "dashboard/**/*.js",
    "!dashboard/dist/**",
    "dashboard/**/*.css",
    "worker/**/*.js",
    "packages/support-chat/**/*.js",
    "launch-video/**/*.js"
  ],
  "ignoreDependencies": ["@types/punycode", "cloudflare"],
  "ignoreBinaries": ["fly", "swift"],
  "entry": [
    "scripts/*.js",
    "plugins/*.cjs",
    "index.js",
    "src/app/**/*.js",
    "dashboard/app.js",
    "dashboard/browser-tools.js",
    "dashboard/screen-time-review.js",
    "dashboard/health-review.js",
    "dashboard/sleep-screen-time.js",
    "dashboard/location-review.js",
    "dashboard/heart-rate-context.js",
    "dashboard/chatgpt-catalog.js",
    "dashboard/chatgpt-catalog-preview.js",
    "dashboard/usage-analytics.js",
    "dashboard/profile-share.js",
    "dashboard/style.css",
    "dashboard/analytics.css",
    "dashboard/docs.css",
    "dashboard/blog.css",
    "worker/index.js",
    "worker/node-fetch.js",
    "worker/cloud-qa.js",
    "fingerprint.config.cjs",
    "packages/support-chat/index.js",
    "packages/support-chat/native.js",
    "packages/support-chat/web.js",
    "packages/support-chat/support-native.js",
    "packages/support-chat/support-web.js",
    "launch-video/index.js",
    "launch-video/render.js"
  ]
}
