{
  "name": "myself-md",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "@aws-sdk/client-s3": "^3.1148.0",
    "@better-auth/oauth-provider": "^1.7.7",
    "@kingstinct/react-native-healthkit": "^16.1.0",
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@react-native-vector-icons/ionicons": "^13.1.4",
    "@shopify/flash-list": "2.0.2",
    "@tabler/icons-react": "^3.49.0",
    "@tanstack/react-table": "^9.2.6",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "expo": "~57.0.27",
    "expo-auth-session": "~57.0.14",
    "expo-background-task": "~57.0.21",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-iap": "^5.8.3",
    "expo-linking": "~57.0.12",
    "expo-location": "~57.0.20",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.21",
    "expo-updates": "~57.0.25",
    "expo-web-browser": "~57.0.3",
    "get-nonce": "^1.0.1",
    "google-auth-library": "^11.2.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.53.0",
    "marked": "^18.1.0",
    "motion": "^14.1.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.7.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-health-connect": "^4.1.3",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.5"
  },
  "scripts": {
    "website:audit": "node scripts/website-audit.js",
    "website:audit:agent": "node scripts/website-audit-agent.js",
    "verify:website-audit": "node scripts/verify-website-audit.js",
    "blog:setup": "node scripts/setup-blog.js",
    "blog:build": "node scripts/build-blog.js --required",
    "blog:check-source": "node scripts/check-blog-source.js",
    "blog:publish": "gh workflow run publish-blog.yml --repo CodyBontecou/myself.md --ref main",
    "blog:verify-live": "node scripts/verify-blog-deployment.js",
    "verify:blog": "node scripts/verify-blog.js",
    "reviewer:prepare": "node scripts/prepare-reviewer.js",
    "mcp:review": "node scripts/review-mcp.js",
    "verify:mcp-metadata": "npm run dashboard:build && node scripts/verify-cloud-http.js && node scripts/verify-support-v1.js",
    "share:build": "node scripts/build-profile-share.js",
    "verify:profile-share": "npm run share:build && node scripts/verify-profile-share.js",
    "share:deploy": "npm run share:build && wrangler deploy --config wrangler.profile-share.jsonc",
    "verify:usage-sessions": "node --experimental-vm-modules scripts/verify-usage-sessions.js",
    "verify:time-series": "node --experimental-vm-modules scripts/verify-time-series.js",
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "server": "node --env-file-if-exists=.env --watch server/index.js",
    "prebuild": "expo prebuild",
    "bundle": "expo export --platform all",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives .",
    "check": "node scripts/check.js",
    "lint:fix": "oxlint --fix .",
    "lint:expo": "eslint . --cache --max-warnings 0",
    "format": "prettier --write --cache .",
    "format:check": "prettier --check --cache .",
    "typecheck": "tsc -p jsconfig.json && tsc -p core/jsconfig.json && tsc -p server/jsconfig.json && tsc -p dashboard/jsconfig.json && tsc -p worker/jsconfig.json",
    "unused": "knip --no-progress",
    "auth:setup": "node scripts/setup-auth.js",
    "auth:start": "node --env-file=.env scripts/start-auth.js",
    "pair": "node --env-file=.env scripts/pair-phone.js",
    "auth:docker": "docker compose up -d",
    "auth:social:install": "node scripts/install-apple-provider.js",
    "auth:social": "node --env-file=.env scripts/setup-social.js",
    "verify:exports": "node scripts/verify-profile-exports.js && node --experimental-vm-modules scripts/verify-export-resilience.js && node --experimental-vm-modules scripts/verify-scheduled-exports.js && node --experimental-vm-modules scripts/verify-export-notifications.js",
    "build:android": "cd android && ./gradlew :app:assembleDebug",
    "build:ios": "xcodebuild -workspace ios/myselfmd.xcworkspace -scheme myselfmd -configuration Release -destination generic/platform=iOS -allowProvisioningUpdates -derivedDataPath .local/xcode/ios-release",
    "cloud:setup": "node scripts/setup-cloud.js",
    "cloud:start": "docker compose --env-file .env.cloud -f compose.cloud.yaml up -d --build",
    "verify:cloud": "npm run dashboard:build && node scripts/verify-cloud-allowance.js && node scripts/verify-cloud.js && node scripts/verify-cloud-http.js",
    "cloud:fly:prepare": "node scripts/prepare-fly.js",
    "cloud:fly:deploy": "fly deploy --config deploy/fly/service.toml --remote-only --ha=false --yes",
    "cloud:run": "node server/start.js",
    "cloud:auth:social": "node --env-file=.env.cloud scripts/setup-social.js --cloud",
    "cloud:domain:setup": "node --env-file=.env.cloud scripts/setup-domain.js",
    "verify:history": "node scripts/verify-history.js && node --experimental-vm-modules scripts/verify-local-history.js",
    "verify:disconnect": "node scripts/verify-disconnect.js && node scripts/verify-session.js && node scripts/verify-session-recovery.js",
    "web": "expo start --web",
    "dashboard:auth": "node --env-file=.env.cloud scripts/setup-dashboard.js --cloud",
    "dashboard:build": "node scripts/build-dashboard.js",
    "verify:dashboard": "npm run dashboard:build && node scripts/verify-dashboard-login.js",
    "verify:explorer": "node scripts/verify-explorer.js",
    "verify:demo": "node scripts/verify-demo.js",
    "verify:billing": "node scripts/verify-billing.js && node --experimental-vm-modules scripts/verify-local-billing.js",
    "verify:whoop": "node --experimental-vm-modules scripts/verify-whoop.js",
    "verify:native-sources": "node --experimental-vm-modules scripts/verify-native-sources.js",
    "verify:migration": "node scripts/verify-migration.js",
    "billing:grant": "node --env-file-if-exists=.env scripts/grant-lifetime.js",
    "cloud:storage": "node --env-file-if-exists=.env.cloud scripts/cloud-storage.js",
    "verify:r2": "npm run dashboard:build && node scripts/verify-r2.js && node scripts/verify-cloud-http.js --r2",
    "worker:types": "wrangler types worker/worker-configuration.d.ts --strict-vars=false",
    "worker:dev": "wrangler dev",
    "worker:deploy": "npm run blog:check-source && npm run dashboard:build && wrangler deploy",
    "worker:check": "tsc -p worker/jsconfig.json",
    "verify:analytics": "node --experimental-vm-modules scripts/verify-native-analytics.js && npm run verify:worker",
    "verify:worker": "npm run dashboard:build && node scripts/verify-worker.js",
    "verify:worker-fetch": "node scripts/verify-worker-fetch.js",
    "verify:identity": "npm run dashboard:build && node scripts/verify-identity.js",
    "identity:prepare": "node --env-file=.env.cloud scripts/migrate-identity.js",
    "identity:snapshot": "node --env-file=.env.cloud scripts/snapshot-identity.js",
    "verify:account-deletion": "npm run verify:identity && node --experimental-vm-modules scripts/verify-account-deletion.js",
    "verify:qa": "node --experimental-vm-modules scripts/verify-qa.js",
    "verify:debug-logs": "node --experimental-vm-modules scripts/verify-debug-logs.js",
    "verify:support-cleanup": "node scripts/verify-support-cleanup.js",
    "start:qa": "EXPO_PUBLIC_QA=1 expo start --port 8082",
    "postinstall": "patch-package --error-on-fail",
    "updates:configure": "EXPO_NO_DOTENV=1 npx --yes eas-cli@24.12.1 update:configure",
    "update:preview": "EXPO_NO_DOTENV=1 npx --yes eas-cli@24.12.1 update --channel preview --environment preview --non-interactive",
    "build:preview": "EXPO_NO_DOTENV=1 npx --yes eas-cli@24.12.1 build --profile preview --non-interactive",
    "verify:support-initial-logs": "node scripts/verify-support-initial-logs.js",
    "verify:support-task": "node scripts/verify-support-task.js",
    "build:ios:debug": "xcodebuild -workspace ios/myselfmd.xcworkspace -scheme myselfmd -configuration Debug -destination \"generic/platform=iOS Simulator\" CODE_SIGNING_ALLOWED=NO -derivedDataPath .local/xcode/ios-simulator-debug",
    "build:ios:device-debug": "xcodebuild -workspace ios/myselfmd.xcworkspace -scheme myselfmd -configuration Debug -destination generic/platform=iOS -allowProvisioningUpdates -derivedDataPath .local/xcode/ios-device-debug",
    "verify:error-json": "node scripts/verify-error-json.js",
    "myself": "node scripts/myself.js",
    "identity:protocol": "node scripts/migrate-protocol.js",
    "verify:protocol": "node --experimental-vm-modules scripts/verify-protocol-migration.js",
    "verify:embedded-debug": "node scripts/verify-embedded-debug.js",
    "build:debug": "EXPO_NO_DOTENV=1 npx --yes eas-cli@24.12.1 build --profile debug --non-interactive",
    "verify:account-linking": "node scripts/verify-account-linking.js && npm run verify:identity",
    "build:beta:ios": "node ../local-phone-builds/src/cli.js start-store ios",
    "build:beta:android": "node ../local-phone-builds/src/cli.js start-store android",
    "submit:beta:ios": "EXPO_NO_DOTENV=1 npx --yes eas-cli@24.12.1 submit --platform ios --profile beta",
    "submit:beta:android": "EXPO_NO_DOTENV=1 npx --yes eas-cli@24.12.1 submit --platform android --profile beta",
    "credentials:beta:ios": "EXPO_NO_DOTENV=1 npx --yes eas-cli@24.12.1 credentials --platform ios",
    "credentials:beta:android": "EXPO_NO_DOTENV=1 npx --yes eas-cli@24.12.1 credentials --platform android",
    "product-hunt:render": "node scripts/render-product-hunt.js",
    "video:studio": "remotion studio launch-video/index.js --public-dir=launch-video/public",
    "video:render": "node launch-video/render.js",
    "video:capture-agent": "node scripts/capture-launch-agent.js",
    "verify:profile-sync": "node scripts/verify-profile-sync.js",
    "verify:profile-pairing": "node --experimental-vm-modules scripts/verify-profile-pairing.js",
    "verify:native-location-capture": "node --experimental-vm-modules scripts/verify-native-location-capture.js"
  },
  "private": true,
  "type": "module",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261009.1",
    "@remotion/bundler": "^4.0.535",
    "@remotion/cli": "^4.0.535",
    "@remotion/renderer": "^4.0.535",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^22",
    "@types/punycode": "^2.1.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.4",
    "@types/react-dom": "~19.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-plugin-oxlint": "^1.87.0",
    "eslint-plugin-react-native": "^5.0.0",
    "knip": "^6.40.0",
    "oxlint": "^1.87.0",
    "patch-package": "^8.0.1",
    "playwright": "^1.64.0",
    "prettier": "^3.9.9",
    "remotion": "^4.0.535",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "wrangler": "^4.149.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
