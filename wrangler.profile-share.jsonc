{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "myself-md-profile-share",
  "account_id": "e4265f322e6380ee832b83ad45e3e8c0",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "preview_urls": false,
