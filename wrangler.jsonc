{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "myself-md",
  "main": "worker/index.js",
  "alias": { "node-fetch": "./worker/node-fetch.js" },
  "account_id": "e4265f322e6380ee832b83ad45e3e8c0",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "triggers": { "crons": ["17 3 * * *"] },
  "routes": [{ "pattern": "myself.md", "custom_domain": true }],
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false,
    },
  },
  "assets": {
    "directory": "dashboard/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
  },
  "r2_buckets": [
    {
      "binding": "EXPORTS",
      "bucket_name": "myself-md-exports",
    },
  ],
  "ratelimits": [
    {
      "name": "ANALYTICS_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  "d1_databases": [
    {
      "binding": "ANALYTICS",
      "database_name": "myself-md-analytics",
      "database_id": "b22e3984-3ac1-400d-9526-398ac712145d",
      "migrations_dir": "worker/analytics-migrations",
    },
    {
      "binding": "IDENTITY",
      "database_name": "myself-md-identity",
      "database_id": "4b6877ee-ce1a-4fab-a65e-d969fcb47f11",
    },
    {
      "binding": "DIRECTORY",
      "database_name": "myself-md-directory",
      "database_id": "9b949e26-bf7e-43de-b797-9d60fbb7cde8",
    },
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["support@myself.md"],
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ACCOUNTS",
        "class_name": "MyselfAccount",
      },
      {
        "name": "PURCHASES",
        "class_name": "MyselfPurchase",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Account", "Purchase"],
    },
    {
      "tag": "v2-myselfmd-reset",
      "new_sqlite_classes": ["MyselfAccount", "MyselfPurchase"],
    },
    {
      "tag": "v3-delete-legacy-storage",
      "deleted_classes": ["Account", "Purchase"],
    },
  ],
  "vars": {
    "ANALYTICS_OPERATORS": "",
    "ANALYTICS_OPERATOR_GITHUB_ID": "20440899",
    "ANALYTICS_INTERNAL_SUBJECTS": "",
    "ANALYTICS_INTERNAL_KEYS": "",
    "ANALYTICS_INTERNAL_ANONYMOUS_IDS": "",
    "PUBLIC_URL": "https://myself.md",
    "PUBLIC_URL_ALIASES": "",
    "OAUTH_ISSUER": "https://myself.md/auth/realms/myselfmd",
    "ACCOUNT_NAMESPACE": "https://myself.md/auth/realms/myselfmd",
    "AUTH_ORIGIN": "https://myself.md",
    "IOS_APP_ID": "67KC823C9A.com.myself.md",
    "ALLOW_HTTP_DEV": "0",
    "MIGRATION_ENABLED": "0",
    "REVIEWER_LOGIN_ENABLED": "1",
    "IDENTITY_ENABLED": "1",
    "GOOGLE_PUBSUB_PUSH_SERVICE_ACCOUNT": "play-rtdn-push@crested-drive-492000-u7.iam.gserviceaccount.com",
  },
  "secrets": {
    "required": [
      "WHOOP_CLIENT_ID",
      "WHOOP_CLIENT_SECRET",
      "CLOUD_ENCRYPTION_KEY",
      "IMPORT_SECRET",
      "IDENTITY_SECRET",
      "GOOGLE_AUTH_CLIENT_ID",
      "GOOGLE_AUTH_CLIENT_SECRET",
      "GITHUB_AUTH_CLIENT_ID",
      "GITHUB_AUTH_CLIENT_SECRET",
      "APPLE_AUTH_CLIENT_ID",
      "APPLE_AUTH_TEAM_ID",
      "APPLE_AUTH_KEY_ID",
      "APPLE_AUTH_PRIVATE_KEY",
      "APPLE_IAP_PRIVATE_KEY",
      "APPLE_IAP_ROOT_CERTIFICATES_BASE64",
      "APPLE_IAP_KEY_ID",
      "APPLE_IAP_ISSUER_ID",
      "APPLE_IAP_APP_ID",
      "ISO_ME_APPLE_APP_ID",
      "HEALTH_MD_APPLE_APP_ID",
      "APPLE_IAP_BUNDLE_ID",
      "LIFETIME_PRODUCT_ID",
      "GOOGLE_SERVICE_ACCOUNT_JSON",
      "GOOGLE_PLAY_PACKAGE",
      "SUPPORT_DISCORD_BOT_TOKEN",
      "SUPPORT_DISCORD_CHANNEL_ID",
      "SUPPORT_ISOBOT_ORIGIN",
      "SUPPORT_ISOBOT_TOKEN",
    ],
  },
}
