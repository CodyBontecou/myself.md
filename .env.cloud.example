SERVICE_DOMAIN=myself.md
CLOUD_ENCRYPTION_KEY=replace-with-64-hex-characters-and-back-up-outside-host
IDENTITY_DB_PASSWORD=replace-with-random-password
IDENTITY_ADMIN_PASSWORD=replace-with-random-password
IDENTITY_ADMIN_USER=admin
IOS_APP_ID=67KC823C9A.com.myself.md
# Optional GitHub sign-in; use an OAuth app with the hosted broker callback.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Apple browser sign-in; keep the private signing key outside the image.
APPLE_SERVICE_ID=com.myself.md.login
APPLE_TEAM_ID=67KC823C9A
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=

# Native purchase verification; place keys/certificates in this read-only mount.
IAP_CREDENTIALS_DIR=./.local/iap
# Paths below are inside the container, e.g. /iap/AppleRootCA-G3.cer or /iap/AuthKey.p8.
LIFETIME_PRODUCT_ID=myself_md_lifetime
APPLE_IAP_APP_ID=
APPLE_IAP_ROOT_CERTIFICATES=
APPLE_IAP_KEY_PATH=
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Existing-app migration. Apple signing key must have access to these apps too.
HEALTH_MD_APPLE_APP_ID=
ISO_ME_APPLE_APP_ID=6761960794

# Optional private Cloudflare R2 content storage; all four values are required together.
# Create an Object Read & Write token restricted to this bucket. Never enable public access.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Cloudflare purchase verification uses secrets in place of local files.
# APPLE_IAP_ROOT_CERTIFICATES_BASE64 is a JSON array of base64-encoded Apple root certificates.
APPLE_IAP_ROOT_CERTIFICATES_BASE64=
APPLE_IAP_PRIVATE_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Google browser OAuth; callback: ${OAUTH_ISSUER}/broker/google/endpoint
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
